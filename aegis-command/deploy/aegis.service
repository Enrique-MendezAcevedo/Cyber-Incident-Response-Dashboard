[Unit]
Description=Aegis independent incident response enclave
After=network.target aegis-firewall.service
Requires=aegis-firewall.service
ConditionPathExists=/etc/aegis/aegis.env

[Service]
Type=simple
User=aegis
Group=aegis
WorkingDirectory=/opt/aegis
EnvironmentFile=/etc/aegis/aegis.env
ExecStart=/usr/bin/node /opt/aegis/server.mjs
Restart=on-failure
RestartSec=5
UMask=0077
StateDirectory=aegis
StateDirectoryMode=0700
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost
IPAddressAllow=10.77.0.0/24
ReadOnlyPaths=/etc/aegis
ReadWritePaths=/var/lib/aegis
LimitNOFILE=4096
TasksMax=128
MemoryMax=1G

[Install]
WantedBy=multi-user.target
