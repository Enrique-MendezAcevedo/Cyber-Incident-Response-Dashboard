# Copy to /etc/aegis/aegis.env. This file contains paths, never private key bytes.
AEGIS_MODE=production
AEGIS_ORIGIN=https://command.aegis.test:8443
AEGIS_HOST=10.77.0.2
PORT=8443
AEGIS_DATABASE=/var/lib/aegis/aegis.sqlite
AEGIS_EVIDENCE_DIR=/var/lib/aegis/evidence
AEGIS_KEY_FILE=/etc/aegis/secrets/storage.key
AEGIS_TLS_KEY=/etc/aegis/secrets/server.key
AEGIS_TLS_CERT=/etc/aegis/server.crt
AEGIS_DEVICE_CA=/etc/aegis/device-ca.crt
